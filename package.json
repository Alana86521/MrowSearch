{
  "name": "mrowsearch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "npm run check:source && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:egress": "node dist/egress/index.js",
    "start:worker": "node dist/worker/index.js",
    "check": "npm run check:source && node scripts/policy-check.mjs",
    "check:source": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "ipaddr.js": "2.2.0",
    "otpauth": "9.5.1",
    "playwright-core": "1.62.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.13",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
